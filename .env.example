# Copy to .env. The defaults work for local development; no real secrets are needed.

# --- database -----------------------------------------------------------------------
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
# host port for psql and notebooks: postgresql://atlas:atlas@localhost:5433/atlas
DB_PORT=5433

# --- document store for AI outputs (MongoDB) ---------------------------------------
# dev placeholders; the root user is created on the first start of the mongo volume
MONGO_USER=atlas
MONGO_PASSWORD=atlas-dev-only
# host port for mongosh: mongodb://atlas:atlas-dev-only@localhost:27018/atlas_ai?authSource=admin
MONGO_PORT=27018
# database name and how long a prediction document is kept (generated text is kept)
AI_STORE_DB=atlas_ai
AI_STORE_PREDICTION_TTL_DAYS=90

# --- API ----------------------------------------------------------------------------
API_PORT=8000
JWT_SECRET=dev-only-change-me
# password for every demo login in the README
DEMO_PASSWORD=atlas-demo
# seed two years of Test Facility history on first start
SEED_DEMO=true

# --- frontend -----------------------------------------------------------------------
WEB_PORT=3000
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Meridian mock data feed --------------------------------------------------------
MERIDIAN_PORT=8200
MERIDIAN_API_KEY=mcx-dev-key
# which live facilities Meridian simulates
FEED_FACILITIES=RGH,RNC,HMC
# history each live facility starts with
FEED_BACKFILL_DAYS=14
# clinical hours per real hour: 1 = real time (a few dozen events an hour), 30 = a fast demo
FEED_CADENCE_SCALE=1

# --- AI features --------------------------------------------------------------------
# the trained model the readmission-risk route serves (baked into the image, mounted in Compose)
MODEL_PATH=/app/models/readmission.joblib
# optional: artifact_sha256 from training/runs/<date>/training_run.json; when set, a file that
# does not match is refused (503) instead of being loaded
MODEL_SHA256=
# the early-warning model: an ONNX file served on CPU, with deterioration.json next to it
MODEL_DETERIORATION_PATH=/app/models/deterioration.onnx
# optional, same idea as MODEL_SHA256: the onnx sha256 from training/runs/<date>-deterioration/
MODEL_DETERIORATION_SHA256=
# Any OpenAI-compatible endpoint works. The course route is Nebius Token Factory; OpenRouter,
# OpenAI or a local server need only a different URL and model name.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# your own key: the summary route answers 503 "no model configured" while this is empty
LLM_API_KEY=
# tokens (input + output) each tenant may spend per UTC day on generative features
LLM_DAILY_TOKEN_LIMIT=200000
