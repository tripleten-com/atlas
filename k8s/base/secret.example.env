# Copy this file to k8s/secret.env (gitignored), set the values, then create the Secret:
#   kubectl -n atlas create secret generic atlas-secrets --from-env-file=k8s/secret.env
#
# POSTGRES_PASSWORD and MERIDIAN_API_KEY are the development placeholders from .env.example;
# they only ever travel inside the cluster. JWT_SECRET must be replaced: it signs every session
# token, and anyone who can read this repository knows the placeholder. Generate one with
#   openssl rand -hex 32
# (Git Bash, macOS, Linux) and paste it in. The API logs a warning at startup while the
# placeholder is in use. LLM_API_KEY is your own model key, or empty to run without the
# summary feature. Never put a real value in this example file; it is committed.
POSTGRES_PASSWORD=atlas
JWT_SECRET=dev-only-change-me
MERIDIAN_API_KEY=mcx-dev-key
LLM_API_KEY=
