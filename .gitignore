# secrets and local config
.env

# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/
build/

# node
node_modules/
frontend/dist/
frontend/.vite/

# feed state when run outside Docker
feed/data/

# trained models: only the serving artifacts (joblib, onnx plus its json) and the README are committed
models/*
!models/.gitkeep
!models/*.joblib
!models/*.onnx
!models/*.json
!models/README.md

# the train scripts write the artifact next to the run record; the copy in models/ is the one committed
training/runs/*/*.joblib
training/runs/*/*.onnx

# local leftovers the task pages tell you to make and never commit: rehearsal training runs
# (--out rehearsal, --out rehearsal-deterioration), the tiny CSV for the lab rehearsal, and
# document-store backups (docs/AI_STORE.md)
rehearsal*/
training/data/tiny.csv
backups/

# the real Kubernetes secret file; k8s/base/secret.example.env is the committed template
k8s/secret.env

# editors and OS
.DS_Store
.idea/
.vscode/
