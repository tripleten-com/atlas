# secrets and local config
.env

# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/
build/

# node
node_modules/
frontend/dist/
frontend/.vite/

# feed state when run outside Docker
feed/data/

# trained models: only the serving artifact and its README are committed
models/*
!models/.gitkeep
!models/*.joblib
!models/README.md

# train.py writes the artifact next to its run record; the copy in models/ is the one committed
training/runs/*/*.joblib

# the real Kubernetes secret file; k8s/base/secret.example.env is the committed template
k8s/secret.env

# editors and OS
.DS_Store
.idea/
.vscode/
