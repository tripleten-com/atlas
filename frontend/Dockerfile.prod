# Production frontend image: build the static site, then serve it with nginx.
# Build from the frontend/ directory:
#   docker build -f frontend/Dockerfile.prod -t atlas-web:sha-$(git rev-parse --short HEAD) ./frontend
#
# The API base URL is not baked in. At container start, docker-entrypoint.d/40-atlas-config.sh
# writes it into /usr/share/nginx/html/config.js from the VITE_API_URL environment variable,
# so the same image works on Compose and on the cluster.

# --- stage 1: build the site ---------------------------------------------------------
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# --- stage 2: serve it ----------------------------------------------------------------
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# the official nginx image runs every executable *.sh in this folder before starting nginx
COPY docker-entrypoint.d/40-atlas-config.sh /docker-entrypoint.d/40-atlas-config.sh
RUN chmod +x /docker-entrypoint.d/40-atlas-config.sh
EXPOSE 80
